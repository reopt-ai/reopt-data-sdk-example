{
  "name": "reopt-data-sdk-example",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A production-shaped Next.js reference for the reopt Data SDK client and server packages.",
  "keywords": [
    "reopt",
    "analytics",
    "data-sdk",
    "nextjs",
    "example"
  ],
  "homepage": "https://github.com/reopt-ai/reopt-data-sdk-example#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reopt-ai/reopt-data-sdk-example.git"
  },
  "bugs": {
    "url": "https://github.com/reopt-ai/reopt-data-sdk-example/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "next dev -p 4100",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "next build",
    "postbuild": "reopt-data inject-chunk-ids --dir .next/static && reopt-data upload-sourcemaps --dir .next/static --url-prefix ${REOPT_DATA_ASSET_PREFIX:-http://localhost:4100/_next/static} --dry-run",
    "start": "node scripts/start.mjs",
    "lint": "oxlint . --report-unused-disable-directives",
    "lint:fix": "oxlint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm feature-map:check && pnpm public:safety",
    "feature-map:check": "tsx scripts/check-feature-map.ts",
    "public:safety": "node scripts/check-public-safety.mjs --history",
    "public:safety:staged": "node scripts/check-public-safety.mjs --staged",
    "verify:quick": "node scripts/verify-feature.mjs quick",
    "verify:full": "node scripts/verify-feature.mjs full",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:devtool": "playwright test --config=playwright.devtool.config.ts",
    "e2e:production": "pnpm build && playwright test --config=playwright.production.config.ts && playwright test --config=playwright.production-diagnostics.config.ts",
    "e2e:deployed": "playwright test --config=playwright.deployed.config.ts",
    "e2e:roundtrip": "playwright test --config=playwright.roundtrip.config.ts",
    "forward": "tsx scripts/forward.ts",
    "sdk:mode": "node scripts/sdk-mode.mjs status",
    "sdk:local": "node scripts/sdk-mode.mjs local",
    "sdk:tarball": "node scripts/sdk-mode.mjs tarball",
    "sdk:npm": "node scripts/sdk-mode.mjs npm",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.9",
    "@reopt-ai/data-contract": "0.8.1",
    "@reopt-ai/data-sdk-client": "0.3.1",
    "@reopt-ai/data-sdk-devtool": "0.2.0",
    "@reopt-ai/data-sdk-server": "0.3.1",
    "@reopt-ai/opt-datagrid": "1.6.0",
    "@reopt-ai/opt-ui": "1.10.0",
    "better-auth": "1.7.1",
    "lucide-react": "1.33.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/env": "16.3.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "^5.9.3"
  }
}
