{
  "$schema": "https://data.reopt.ai/schemas/event-catalog.v1.json",
  "version": 1,
  "projectId": "cmta2v4g60005zfyqq9eya1he",
  "events": {
    "$pageview": {
      "displayName": "Page viewed",
      "category": "navigation",
      "rollupProperties": ["path", "utm_source", "utm_medium", "utm_campaign"]
    },
    "product.viewed": {
      "displayName": "Product viewed",
      "category": "commerce",
      "rollupProperties": ["category", "price_band", "product_slug"]
    },
    "cart.added": {
      "displayName": "Cart item added",
      "category": "commerce",
      "rollupProperties": ["category", "price_band", "currency"]
    },
    "cart.updated": {
      "displayName": "Cart item updated",
      "category": "commerce",
      "rollupProperties": ["category", "price_band", "currency"]
    },
    "cart.removed": {
      "displayName": "Cart item removed",
      "category": "commerce",
      "rollupProperties": ["category", "price_band", "currency"]
    },
    "checkout.submitted": {
      "displayName": "Checkout submitted",
      "category": "commerce",
      "rollupProperties": ["mode", "currency", "value_band"]
    },
    "checkout.started": {
      "displayName": "Checkout started",
      "category": "commerce",
      "rollupProperties": ["currency", "value_band", "item_count"]
    },
    "order.completed": {
      "displayName": "Order completed",
      "conversion": true,
      "category": "commerce",
      "rollupProperties": ["source", "currency", "value_band"]
    },
    "order.reconciled": {
      "displayName": "Order reconciled",
      "status": "internal",
      "category": "commerce",
      "rollupProperties": ["source", "currency", "value_band"]
    },
    "search.performed": {
      "displayName": "Search performed",
      "rollupProperties": ["query_length"]
    },
    "lab.ping": {
      "displayName": "Diagnostics ping",
      "status": "internal",
      "category": "diagnostics",
      "rollupProperties": ["source"]
    }
  }
}
