# @reopt-ai packages are published to the public npm registry. Pin the scope to
# it explicitly so a contributor's global ~/.npmrc (e.g. a GitHub Packages route
# for @reopt-ai) can't re-resolve these to a private registry and bake
# npm.pkg.github.com URLs into pnpm-lock.yaml. No auth token is needed here.
@reopt-ai:registry=https://registry.npmjs.org
