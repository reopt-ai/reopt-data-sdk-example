# The app starts without credentials. The SDK is fail-open: without a write key
# it logs one warning and every analytics call becomes a no-op.
#
# Local SDK development uses `.reopt-local.json`, generated by
# `pnpm reopt:setup`, instead of this file. A write key belongs to a project and
# is selected from the request host, so it is resolved at request time rather
# than compiled into the application.
#
# These variables are the fallback for deployments where that file is not
# available. None use the `NEXT_PUBLIC_` prefix: the server resolves even the
# public write key and passes it through the client component boundary.

# Origin of the reopt Data endpoint.
REOPT_DATA_BASE_URL=http://localhost:4001

# Public project write key, shared with the browser SDK.
REOPT_DATA_WRITE_KEY=

# Server credentials issued together when an API client is created.
# clientId identifies the API client record; it is not the write key.
REOPT_DATA_CLIENT_ID=
REOPT_DATA_CLIENT_SECRET=

# Required in production. Use a random value of at least 32 characters.
# Development generates a process-local value when this is empty.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4100

# Raw SDK payloads and deployment metadata are hidden in production by default.
# Enable only for a controlled example deployment, never for a customer app.
REOPT_DATA_EXAMPLE_DIAGNOSTICS=false

# reopt-data checkout used by `pnpm sdk:local` (default: ../reopt-data).
# REOPT_DATA_PATH=../reopt-data
